<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/onboardingFragment">

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.example.financeiro.ui.onboarding.OnboardingFragment"
        android:label="Onboarding">

        <action
            android:id="@+id/action_onboarding_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.financeiro.ui.dashboard.DashboardFragment"
        android:label="Dashboard" />

    <fragment
        android:id="@+id/transacaoListFragment"
        android:name="com.example.financeiro.ui.transacao.TransacaoListFragment"
        android:label="Transações">

        <!-- Ação para adicionar/editar implementada na S17 -->
        <!--
        <action
            android:id="@+id/action_lista_to_adicionar"
            app:destination="@id/adicionarTransacaoFragment" />
        -->
    </fragment>

</navigation>