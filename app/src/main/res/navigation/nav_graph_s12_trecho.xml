<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/onboardingFragment">

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.example.financeiro.ui.onboarding.OnboardingFragment"
        android:label="Onboarding">

        <action
            android:id="@+id/action_onboarding_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <action
        android:id="@+id/action_global_dashboard"
        app:destination="@id/dashboardFragment"
        app:popUpTo="@id/onboardingFragment"
        app:popUpToInclusive="true" />

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.financeiro.ui.dashboard.DashboardFragment"
        android:label="Dashboard">

        <action
            android:id="@+id/action_dashboard_to_transacoes"
            app:destination="@id/transacaoListFragment" />

        <action
            android:id="@+id/action_dashboard_to_adicionar_transacao"
            app:destination="@id/adicionarTransacaoFragment" />

        <action
            android:id="@+id/action_dashboard_to_carteira"
            app:destination="@id/carteiraFragment" />

        <action
            android:id="@+id/action_dashboard_to_categorias"
            app:destination="@id/categoriasFragment" />

        <action
            android:id="@+id/action_dashboard_to_relatorios"
            app:destination="@id/relatoriosFragment" />
    </fragment>

    <fragment
        android:id="@+id/transacaoListFragment"
        android:name="com.example.financeiro.ui.transacao.TransacaoListFragment"
        android:label="Transações">

        <!-- Ação para adicionar/editar implementada na S17 -->
        <action
            android:id="@+id/action_lista_to_adicionar"
            app:destination="@id/adicionarTransacaoFragment" />
    </fragment>

    <fragment
        android:id="@+id/adicionarTransacaoFragment"
        android:name="com.example.financeiro.ui.transacao.AdicionarTransacaoFragment"
        android:label="Nova TransaÃ§Ã£o">

        <argument
            android:name="transacaoId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

    <fragment
        android:id="@+id/carteiraFragment"
        android:name="com.example.financeiro.ui.carteira.CarteiraFragment"
        android:label="Contas e cartoes">

        <action
            android:id="@+id/action_carteira_to_fatura"
            app:destination="@id/faturaCartaoFragment" />

        <action
            android:id="@+id/action_carteira_to_extrato"
            app:destination="@id/extratoContaFragment" />
    </fragment>

    <fragment
        android:id="@+id/faturaCartaoFragment"
        android:name="com.example.financeiro.ui.fatura.FaturaCartaoFragment"
        android:label="Fatura do cartao">

        <argument
            android:name="cartaoId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/extratoContaFragment"
        android:name="com.example.financeiro.ui.extrato.ExtratoContaFragment"
        android:label="Extrato da conta">

        <argument
            android:name="contaId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/categoriasFragment"
        android:name="com.example.financeiro.ui.categoria.CategoriasFragment"
        android:label="Categorias" />

    <fragment
        android:id="@+id/relatoriosFragment"
        android:name="com.example.financeiro.ui.relatorio.RelatoriosFragment"
        android:label="Relatorios" />

</navigation>
